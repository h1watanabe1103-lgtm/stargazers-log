{
  "name": "my-app2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:legacy && npm run test:components",
    "preview": "vite preview",
    "test:legacy": "node --test src/*.test.js",
    "test:components": "vitest run --config vitest.config.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^27.0.0",
    "vitest": "^4.0.16",
    "@playwright/test": "^1.64.1"
  }
}

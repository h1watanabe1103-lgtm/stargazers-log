services:
  db:
    image: mcr.microsoft.com/mssql/server:2022-latest
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_PID: "Developer"
      MSSQL_SA_PASSWORD: ${MSSQL_SA_PASSWORD:-Dev_Passw0rd!2026}
    ports:
      - "1433:1433"          # dotnet run（ホスト側）からもつなげるように公開
    volumes:
      - sqlserver-data:/var/opt/mssql
    healthcheck:
      test: ["CMD-SHELL", "/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P \"$$MSSQL_SA_PASSWORD\" -Q \"SELECT 1\" || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  api:
    build: .
    depends_on:
      db:
        condition: service_healthy   # DBが起動完了してからAPIを起動
    environment:
      ASPNETCORE_ENVIRONMENT: Development   # Scalar（試用画面）を見るため
      # JWT（ログインのトークン）の署名用の鍵。32文字以上。本番では、必ず別の値を環境変数で渡す
      Jwt__Key: ${JWT_KEY:-dev-only-secret-key-change-me-0123456789abcdef}
      # 接続先のホスト名は localhost ではなくサービス名「db」
      ConnectionStrings__DefaultConnection: "Server=db,1433;Database=EmployeeDb;User Id=sa;Password=${MSSQL_SA_PASSWORD:-Dev_Passw0rd!2026};TrustServerCertificate=True"
    ports:
      - "8080:8080"

volumes:
  sqlserver-data:
